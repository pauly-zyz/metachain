# Network: local (anvil fork from scripts/e2e-local.sh up) | testnet | mainnet
NEXT_PUBLIC_NETWORK=local
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# ERC-4337 bundler, SERVER-SIDE ONLY (proxied by /api/bundler so the API key never reaches the browser).
# Testnet example (Pimlico, slug "robinhood-testnet"): https://api.pimlico.io/v2/robinhood-testnet/rpc?apikey=YOUR_KEY
BUNDLER_RPC_URL=http://127.0.0.1:4337
# Optional: call a bundler directly from the browser instead of the proxy (must allow CORS, no secret in URL!)
# NEXT_PUBLIC_BUNDLER_URL=
# Contents of contracts/deployments/<name>.json (written by script/Deploy.s.sol)
NEXT_PUBLIC_DEPLOYMENT_JSON=
