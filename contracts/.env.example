# Copy to contracts/.env (gitignored). NEVER commit real keys.
# Deployer key (needs testnet ETH on Robinhood Chain Testnet).
PRIVATE_KEY=
# Final owner of oracle / paymaster / AgentPayments (use a multisig on mainnet). Defaults to the deployer on testnet.
OWNER=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# ETH sent to the EntryPoint for the paymaster (deposit pays gas; stake is required by ERC-7562 for token paymasters)
PAYMASTER_DEPOSIT_WEI=20000000000000000
PAYMASTER_STAKE_WEI=5000000000000000
# Mainnet only — requires explicit owner approval, see docs/pre-mainnet-checklist.md
# CONFIRM_MAINNET_DEPLOY=I_UNDERSTAND_THIS_IS_MAINNET
